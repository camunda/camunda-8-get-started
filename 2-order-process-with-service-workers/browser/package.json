{
  "name": "order-process-browser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The order-process example running entirely in your browser: the real WebAssembly build of the nanobpm engine executes the BPMN, and you edit the service-worker JavaScript live in Monaco. No Camunda 8 cluster required.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@camunda/design-system": "^0.36.0",
    "@monaco-editor/react": "^4.6.0",
    "@nanobpm/bojtos-kit": "^0.1.0",
    "@nanobpm/bojtos-react": "^0.1.0",
    "@nanobpm/engine-wasm": "^0.1.0",
    "bpmn-js": "^18.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
